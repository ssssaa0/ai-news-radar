# ===== AI 资讯雷达 · 环境变量 =====
# GitHub Actions：在仓库 Settings → Secrets and variables → Actions 中配置
# 本地调试：复制本文件为 .env.local（不会被 git 提交），手动 export 后运行

# Resend.com API Key —— https://resend.com 注册后在 API Keys 页面创建
# 免费额度：每月 3000 封；不验证域名时只能发给你注册 Resend 的邮箱
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 收件邮箱（不填则回退使用 Gist 偏好里订阅的邮箱）
WEEKLY_RECIPIENT=your@email.com

# 发件人（可选）
# 未验证域名时必须使用官方沙箱地址：
WEEKLY_FROM=AI 资讯雷达 <onboarding@resend.dev>
# 验证自己的域名后可改为：
# WEEKLY_FROM=AI 资讯雷达 <weekly@yourdomain.com>

# GitHub Token（读取私密 Gist 偏好，仅需 gist 权限）
# https://github.com/settings/tokens
GH_GIST_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 偏好 Gist ID（在网页端「订阅源 → 云端同步」首次同步后自动生成）
PREFS_GIST_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
